import qrcode

qr = qrcode.QRCode(
    version=None,
    error_correction=qrcode.constants.ERROR_CORRECT_L,
    box_size=10,
    border=4,
)

user_input = input("Enter your URL :")
qr.add_data(user_input) 
qr.make(fit=True)
img = qr.make_image(back_color=(255, 195, 235), fill_color=(55, 95, 35))
img.save("qr.png") 